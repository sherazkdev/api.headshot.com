NODE_ENV=development
PORT=3000
API_BASE_PATH=/v1
ADMIN_ORIGIN=http://localhost:3001
# VPS: public HTTPS URL for image links
# PUBLIC_BASE_URL=https://aiheadshotapi.com

# Admin portal login
ADMIN_EMAIL=admin@headshotapi.com
ADMIN_PASSWORD=changeme-min-8-chars
JWT_SECRET=replace-with-long-random-string

# Firebase Auth + Firestore (users, credits, jobs, purchases)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# or path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS=

# AI — never ship in the mobile app
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# BFL/Flux is not used by POST /v1/headshots/generate (legacy provider:bfl is ignored).
BFL_API_KEY=
BFL_FLUX_MODEL=flux-2-klein-4b
# BytePlus ModelArk — when BYTEPLUS_API_KEY is set, ALL AI (generate + vision) prefers BytePlus; Gemini is fallback.
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_MODEL=dola-seedream-5-0-flash-260915
# Activate this model in ModelArk console for your account (GET /v1/models → VLM).
BYTEPLUS_VISION_MODEL=seed-2-0-lite-260428
# legacy alias for BYTEPLUS_MODEL
BYTEPLUS_SEEDREAM_MODEL=
# Legacy default when request omits provider; "bfl" here does not route to Flux anymore.
HEADSHOT_AI_PROVIDER=gemini

# Google Play
# false = grant premium without Play Console match (use until Google API is ready)
# true  = match purchaseToken against Play Console (needs SA JSON + real package name)
GOOGLE_PLAY_VERIFY_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.headshotai
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Storage
STORAGE_DRIVER=local
GCS_BUCKET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Redis for multi-process queue (in-memory used if empty)
REDIS_URL=

# AdMob SSV
ADMOB_SSV_VERIFIER_ENABLED=true

# Concurrency
CLUSTER_WORKERS=0
MAX_INFLIGHT_AI=32
IDEMPOTENCY_TTL_HOURS=24
MAX_UPLOAD_MB=10
AI_REQUEST_TIMEOUT_MS=180000
