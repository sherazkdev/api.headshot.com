[Unit]
Description=Headshot API (Fastify) — OPTIONAL, only if you use systemd with root
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/headshot-api
EnvironmentFile=/var/www/headshot-api/.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

# AI jobs can run several minutes
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
