# Headshot API — nginx reverse proxy (optional)
# Render: bash deploy/nginx/render-config.sh
#
# Sirf tab use karo jab .env mein PORT=3000 ho (nginx :3016 → node :3000).
# Default production: PORT=3016 — PM2 direct, is nginx file include NA karo.

upstream headshot_api_backend {
    server 127.0.0.1:__API_PORT__;
    keepalive 32;
}

server {
    listen 3016;
    listen [::]:3016;
    server_name _;

    client_max_body_size 12m;

    access_log __APP_ROOT__/logs/nginx-headshot-api.access.log;
    error_log  __APP_ROOT__/logs/nginx-headshot-api.error.log warn;

    location /uploads/ {
        alias __APP_ROOT__/uploads/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /generated/ {
        alias __APP_ROOT__/generated/;
        expires 1d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location /docs {
        proxy_pass http://headshot_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://headshot_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    180s;
        proxy_read_timeout    180s;
        send_timeout          180s;
    }
}
