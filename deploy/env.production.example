# Copy to /var/www/headshot-api/.env
# HAR variable ALAG LINE par — ek line par multiple values MAT likho
#
# PORT vs 3016:
#   PORT=3000        → Node/PM2 (internal, nginx is se connect karta hai)
#   nginx :3016      → bahar se API (deploy/nginx/headshot-api.conf)
#   PUBLIC_BASE_URL  → jo URL mobile/images use karein (3016 ya domain)

NODE_ENV=production
PORT=3000
API_BASE_PATH=/v1
ADMIN_ORIGIN=https://aiheadshotapi.com

# Option A — IP + nginx port 3016 (bina SSL domain)
PUBLIC_BASE_URL=http://YOUR_VPS_IP:3016

# Option B — domain + SSL (443, port .env mein nahi likhte)
# PUBLIC_BASE_URL=https://api.aiheadshotapi.com
MONGODB_URI=mongodb://127.0.0.1:27017/headshot_ai

ADMIN_EMAIL=admin@headshotapi.com
ADMIN_PASSWORD=change-this-strong-password
JWT_SECRET=change-this-to-32-plus-random-chars

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

GEMINI_API_KEY=
GOOGLE_PLAY_VERIFY_ENABLED=false
AI_REQUEST_TIMEOUT_MS=180000
