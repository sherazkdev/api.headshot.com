# /var/www/headshot-api/.env — production (aiheadshotapi.com + SSL)
# HAR variable ALAG LINE par

NODE_ENV=production
PORT=3016
BIND_HOST=127.0.0.1
API_BASE_PATH=/v1

PUBLIC_BASE_URL=https://aiheadshotapi.com
ADMIN_ORIGIN=https://aiheadshotapi.com

ADMIN_EMAIL=admin@headshotapi.com
ADMIN_PASSWORD=change-this-strong-password
JWT_SECRET=change-this-to-32-plus-random-chars

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

GEMINI_API_KEY=
# All AI features prefer BytePlus when BYTEPLUS_API_KEY is set (Gemini fallback on errors).
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_MODEL=dola-seedream-5-0-flash-260915
BYTEPLUS_VISION_MODEL=seed-2-0-lite-260428
# Headshots ignore legacy provider:bfl / BFL — BytePlus then Gemini fallback only.
GOOGLE_PLAY_VERIFY_ENABLED=false
AI_REQUEST_TIMEOUT_MS=180000
FIREBASE_VERIFY_TIMEOUT_MS=8000
FIREBASE_TOKEN_CACHE_TTL_SEC=120
